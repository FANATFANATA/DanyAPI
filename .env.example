# DeepSeek: token pool (comma-separated, from different accounts).
# Each account serves one message at a time - more tokens = more parallel generations.
DEEPSEEK_TOKENS=
# Or a single email+password account (login at startup).
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

# DanyAPI
DANYAPI_HOST=0.0.0.0
DANYAPI_PORT=8000
DANYAPI_TIMEOUT=60
