# DeepSeek: пул токенов (через запятую, с разных аккаунтов).
# Каждый аккаунт обслуживает одно сообщение одновременно — больше токенов = больше параллельных генераций.
DEEPSEEK_TOKENS=
# Либо одна учётка email+пароль (логин при старте).
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=
# Опционально: фиксированный device_id для клиентов.
DEEPSEEK_DEVICE_ID=

# DanyAPI
DANYAPI_HOST=0.0.0.0
DANYAPI_PORT=8000
DANYAPI_TIMEOUT=60
